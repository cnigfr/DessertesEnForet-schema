{
  "$schema": "https://frictionlessdata.io/schemas/table-schema.json",
  "name": "equipement",
  "title": "Équipement en forêt",
  "description": "Équipements présents en forêt liés au stockage, transport de bois et DFCI, conformes au standard CNIG Dessertes en forêt v2.0",
  "countryCode": "FR",
  "homepage": "https://cnig.gouv.fr/gt-dessertes-pour-les-transports-de-bois-a18535.html",
  "path": "https://schema.data.gouv.fr/cnigfr/schema-desserte-transport-bois/latest/equipement.json",
  "created": "2026-06-18",
  "version": "1.0.0",
  "fields": [
    {
      "name": "identifiant",
      "title": "Identifiant pour la diffusion",
      "description": "Identifiant unique de l'objet",
      "type": "string",
      "example": "EQU_DESS0000002008897356",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "code_insee_commune",
      "title": "Code INSEE de la commune",
      "description": "Code INSEE de la commune où se situe l'équipement",
      "type": "string",
      "pattern": "^[0-9AB]{5}$",
      "example": "27098"
    },
    {
      "name": "nature",
      "title": "Nature de l'équipement",
      "description": "Type d'équipement",
      "type": "string",
      "enum": [
        "Aire de croisement",
        "Aire de dépôt-retournement",
        "Aire de retournement",
        "Place de dépôt"
      ],
      "example": "Place de dépôt",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "gestionnaire",
      "title": "Gestionnaire",
      "description": "Organisme gestionnaire de l'équipement",
      "type": "string",
      "example": "Office National des Forêts"
    },
    {
      "name": "nature_troncon",
      "title": "Nature du tronçon de route",
      "description": "Type de revêtement du tronçon à proximité",
      "type": "string",
      "enum": [
		"Chemin",
		"Route empierrée",
		"Route à 1 chaussée"
	  ],
      "example": "Route empierrée"
    },
    {
      "name": "nom",
      "title": "Nom",
      "description": "Nom de l'équipement",
      "type": "string",
      "example": "Place de dépôt du Grand Duc"
    },
    {
      "name": "commentaire",
      "title": "Commentaire",
      "description": "Commentaire précisant des informations sur l'équipement",
      "type": "string",
      "example": "Accès difficile en période hivernale"
    },
    {
      "name": "contributeur",
      "title": "Contributeur",
      "description": "Nom du producteur/contributeur de la donnée",
      "type": "string",
      "example": "Crige"
    },
    {
      "name": "longueur",
      "title": "Longueur",
      "description": "Longueur maximale possible en mètres",
      "type": "number",
      "example": "35"
    },
    {
      "name": "largeur",
      "title": "Largeur",
      "description": "Largeur maximale possible en mètres",
      "type": "number",
      "example": "3.5"
    }
  ]
}